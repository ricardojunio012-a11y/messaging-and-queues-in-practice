# How orders-api talks to the notifications service:
#   direct       -> HTTP call with no timeout
#   timeout      -> HTTP call with a timeout and retries
#   memory-queue -> queue inside the API's own process
MODE=direct
TIMEOUT_MS=1000
ATTEMPTS=3

# Artificial delay of the notifications service, in milliseconds
LATENCY_MS=0

# Load generator: total orders (N) and concurrent orders (C)
N=20
C=5
