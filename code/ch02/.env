# How the consumer takes a message from the queue:
#   status      -> marks the row as "processing" and commits the transaction
#   transaction -> keeps the row locked in an open transaction during processing
#   lease       -> makes the message invisible for LEASE_S seconds
CONSUME_MODE=status
LEASE_S=15

# Lease mode: how many times a message can be reserved before it is parked
MAX_ATTEMPTS=5

# Time the consumer takes to "send" each email, in milliseconds
LATENCY_MS=200

# Load generator: total orders (N) and concurrent orders (C)
N=20
C=5
