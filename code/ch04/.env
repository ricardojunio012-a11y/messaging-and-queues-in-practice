# Producer (orders-api)
#   CONFIRMATION=yes -> waits for the broker's confirmation (publisher confirms)
#   PERSISTENT=yes   -> publishes the message as persistent (written to disk)
CONFIRMATION=yes
PERSISTENT=yes

# Consumer (notifications)
#   ACK_MODE: after | before | auto
#   FAIL_ON_MESSAGE: the consumer dies once while processing the Nth message (0 = never)
ACK_MODE=after
FAIL_ON_MESSAGE=0
LATENCY_MS=200

# Load generator: total orders (N) and concurrent orders (C)
N=20
C=5
