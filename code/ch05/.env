# Producer: DUPLICATE_PUBLISH=yes publishes each message twice, with the same id,
# like a producer that repeats the publish because it did not get the confirmation
DUPLICATE_PUBLISH=no

# Consumer
#   IDEMPOTENCY: none | inbox | key
#   FAIL_ON_MESSAGE: dies once after sending the email of the Nth message (0 = never)
IDEMPOTENCY=none
FAIL_ON_MESSAGE=0
LATENCY_MS=100

# Load generator: total orders (N) and concurrent orders (C)
N=20
C=5
