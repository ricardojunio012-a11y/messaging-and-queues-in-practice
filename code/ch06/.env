# Producer: key used when publishing to Kafka
#   random -> each event goes to any partition
#   order  -> all events of the same order go to the same partition
KEY=random

# Consumer: how the events are applied to the order status
#   naive     -> always applies the event that arrives
#   versioned -> only applies events newer than the current state
APP=naive
# Random delay in processing each event, from 0 up to this value (ms)
LATENCY_MAX_MS=300

# Load generator: total orders (N) and concurrent orders (C)
N=20
C=5
