# What to do when processing fails
#   immediate -> nack with requeue: the message goes back to the queue and is redelivered
#                at once
#   backoff   -> retry queues with a growing delay; after the limit, or if the error is
#                permanent, the message goes to the DLQ
RETRY_MODE=immediate
# Extra attempts before the DLQ (backoff mode)
MAX_ATTEMPTS=3

# Probability that the simulated SEFAZ fails on each call (0 to 1)
FAILURE_RATE=0.3
# Bug fix: accept the total as text ("150.00", or "150,00" with a decimal comma)
ACCEPT_TOTAL_AS_TEXT=no
# Duration of each call to the simulated SEFAZ (ms)
LATENCY_MS=50

# Load generator: total orders
N=20
# Redrive: messages returned per second
REDRIVE_PER_SECOND=5
