# Processing time of each order in the consumer (ms).
# With 100 ms, each instance processes at most about 10 orders per second.
PROCESSING_MS=100

# Deadline of each order (s): the consumer discards, without processing, an order that
# waited longer than this in the queue (deadline-based dropping, section 9.8).
# 0 = no deadline
MAX_TIME_S=0
