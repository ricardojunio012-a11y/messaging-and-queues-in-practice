# How orders-api writes the order and the event
#   dual   -> writes the order to the database and then publishes to the broker
#             (dual write)
#   outbox -> writes the order and the event to the outbox, in the same transaction;
#             the relay publishes later
WRITE=dual

# Brings the relay down once, after publishing and before marking as published
RELAY_FAIL_AFTER_PUBLISH=no

# Load generator: total orders
N=10
