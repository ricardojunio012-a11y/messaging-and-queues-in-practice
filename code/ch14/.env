# Saga style
#   choreography  -> each service reacts to the other services' events
#   orchestration -> the orders service commands the steps and keeps the saga state
SAGA=choreography

# Orchestration: seconds the orchestrator waits for the payment before cancelling
SAGA_TIMEOUT_S=15

# Step 6: orchestrator pause, in milliseconds, before writing the payment step's
# advance; simulates a slow orchestrator (0 = no pause)
ORCHESTRATOR_PAUSE_MS=0
