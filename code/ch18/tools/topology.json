{
  "exchanges": [
    {"name": "orders", "vhost": "/", "type": "topic", "durable": true,
     "auto_delete": false, "internal": false, "arguments": {}},
    {"name": "notices", "vhost": "/", "type": "fanout", "durable": true,
     "auto_delete": false, "internal": false, "arguments": {}},
    {"name": "reports", "vhost": "/", "type": "headers", "durable": true,
     "auto_delete": false, "internal": false, "arguments": {}},
    {"name": "orders.dlx", "vhost": "/", "type": "fanout", "durable": true,
     "auto_delete": false, "internal": false, "arguments": {}}
  ],
  "queues": [
    {"name": "inventory.reserve", "vhost": "/", "durable": true, "auto_delete": false,
     "arguments": {"x-queue-type": "quorum", "x-delivery-limit": 5,
                   "x-dead-letter-exchange": "orders.dlx"}},
    {"name": "notifications.email", "vhost": "/", "durable": true, "auto_delete": false,
     "arguments": {"x-queue-type": "quorum", "x-dead-letter-exchange": "orders.dlx"}},
    {"name": "loyalty.points", "vhost": "/", "durable": true, "auto_delete": false,
     "arguments": {"x-queue-type": "quorum"}},
    {"name": "audit", "vhost": "/", "durable": true, "auto_delete": false,
     "arguments": {"x-queue-type": "stream", "x-max-age": "7D"}},
    {"name": "dashboard.alerts", "vhost": "/", "durable": true, "auto_delete": false,
     "arguments": {"x-queue-type": "quorum"}},
    {"name": "reports.pdf", "vhost": "/", "durable": true, "auto_delete": false,
     "arguments": {"x-queue-type": "quorum"}},
    {"name": "orders.dead", "vhost": "/", "durable": true, "auto_delete": false,
     "arguments": {"x-queue-type": "quorum"}}
  ],
  "bindings": [
    {"source": "orders", "vhost": "/", "destination": "inventory.reserve",
     "destination_type": "queue", "routing_key": "order.created", "arguments": {}},
    {"source": "orders", "vhost": "/", "destination": "notifications.email",
     "destination_type": "queue", "routing_key": "order.*", "arguments": {}},
    {"source": "orders", "vhost": "/", "destination": "loyalty.points",
     "destination_type": "queue", "routing_key": "order.paid", "arguments": {}},
    {"source": "orders", "vhost": "/", "destination": "audit",
     "destination_type": "queue", "routing_key": "#", "arguments": {}},
    {"source": "notices", "vhost": "/", "destination": "dashboard.alerts",
     "destination_type": "queue", "routing_key": "", "arguments": {}},
    {"source": "notices", "vhost": "/", "destination": "audit",
     "destination_type": "queue", "routing_key": "", "arguments": {}},
    {"source": "reports", "vhost": "/", "destination": "reports.pdf",
     "destination_type": "queue", "routing_key": "",
     "arguments": {"x-match": "all", "format": "pdf"}},
    {"source": "orders.dlx", "vhost": "/", "destination": "orders.dead",
     "destination_type": "queue", "routing_key": "", "arguments": {}}
  ]
}
