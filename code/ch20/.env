# Producer topic and confirmation
#   payments-risky: min.insync.replicas=1 and leader election outside the ISR allowed
#   payments-safe:  min.insync.replicas=2 and election only within the ISR
TOPIC=payments-risky
# 1: confirms when the leader has written | all: when every ISR replica has written
ACKS=1

# Payments published on each run of the producer
N=1000

# Consumer (step 3): topic it reads and reconciliation time for each payment
CONSUME_TOPIC=payments-safe
PROCESSING_MS=200
