# Lab passwords, only for this local environment. In production, use a secrets
# vault (section 23.1) and never commit them to the repository. The RabbitMQ passwords
# are also in rabbitmq/definitions.json, as hashes: changing them only here does not
# change them there.
PASSWORD_ADMIN=admin-lab-23
PASSWORD_ORDERS_API=api-lab-23
PASSWORD_NOTIFICATIONS=notif-lab-23
PASSWORD_MARKETING=mkt-lab-23
PASSWORD_PAYMENTS=pay-lab-23
PASSWORD_FINANCE=fin-lab-23
PASSWORD_REPORTS=rep-lab-23
# Production quota of the reports user in Kafka, in bytes per second
REPORTS_QUOTA=51200
